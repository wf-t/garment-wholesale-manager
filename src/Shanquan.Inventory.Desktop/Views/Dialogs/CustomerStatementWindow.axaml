<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:compat="using:Shanquan.Inventory.Desktop.Compatibility"
        xmlns:services="using:Shanquan.Inventory.Desktop.Services"
        x:Class="Shanquan.Inventory.Desktop.Views.Dialogs.CustomerStatementWindow"
        x:DataType="services:CustomerStatementData"
        Width="860" Height="650" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" Background="#F6F3F0" Title="客户对账单">
    <compat:SpacingGrid RowDefinitions="Auto,*,Auto">
        <Border Background="#302522" Padding="28,22"><compat:SpacingGrid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="客户对账单" Foreground="#E7C5C4" FontSize="11" FontWeight="SemiBold" /><TextBlock Text="{Binding CustomerName}" Foreground="White" FontSize="24" FontWeight="Bold" Margin="0,7,0,0" /><TextBlock Text="{Binding PeriodText}" Foreground="#BBAEAA" FontSize="10" Margin="0,5,0,0" /></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="未结余额" Foreground="#BBAEAA" FontSize="10" TextAlignment="Right" /><TextBlock Text="{Binding ReceivableText}" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,7,0,0" /></StackPanel></compat:SpacingGrid></Border>
        <Border Grid.Row="1" Margin="22,18" Background="White" BorderBrush="#E7DFDA" BorderThickness="1" CornerRadius="12" ClipToBounds="True"><compat:SpacingGrid RowDefinitions="42,*"><compat:SpacingGrid Background="#F7F3F1" ColumnDefinitions="105,75,160,100,100,*" Margin="16,0" ColumnSpacing="10"><TextBlock Text="日期" VerticalAlignment="Center" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="类型" VerticalAlignment="Center" FontWeight="SemiBold" /><TextBlock Grid.Column="2" Text="单号" VerticalAlignment="Center" FontWeight="SemiBold" /><TextBlock Grid.Column="3" Text="应收" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" /><TextBlock Grid.Column="4" Text="收款" VerticalAlignment="Center" TextAlignment="Right" FontWeight="SemiBold" /><TextBlock Grid.Column="5" Text="备注" VerticalAlignment="Center" FontWeight="SemiBold" /></compat:SpacingGrid><ScrollViewer Grid.Row="1"><ItemsControl ItemsSource="{Binding Lines}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="services:CustomerStatementLine"><Border BorderBrush="#EEE7E3" BorderThickness="0,0,0,1" Padding="16,11"><compat:SpacingGrid ColumnDefinitions="105,75,160,100,100,*" ColumnSpacing="10"><TextBlock Text="{Binding DateText}" FontSize="10" /><TextBlock Grid.Column="1" Text="{Binding Type}" FontSize="10" /><TextBlock Grid.Column="2" Text="{Binding ReferenceNumber}" FontSize="10" /><TextBlock Grid.Column="3" Text="{Binding DebitText}" TextAlignment="Right" FontSize="10" /><TextBlock Grid.Column="4" Text="{Binding CreditText}" TextAlignment="Right" FontSize="10" Foreground="#318A65" /><TextBlock Grid.Column="5" Text="{Binding Note}" FontSize="10" Foreground="#817773" /></compat:SpacingGrid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></compat:SpacingGrid></Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E8E0DB" BorderThickness="0,1,0,0" Padding="22,14"><StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"><Button Background="White" Foreground="#4A403C" BorderBrush="#D8CEC8" BorderThickness="1" CornerRadius="9" Padding="22,9" Click="Export_Click">导出 CSV</Button><Button Background="#9D3037" Foreground="White" BorderThickness="0" CornerRadius="9" Padding="22,9" Click="Close_Click">关闭</Button></StackPanel></Border>
    </compat:SpacingGrid>
</Window>
