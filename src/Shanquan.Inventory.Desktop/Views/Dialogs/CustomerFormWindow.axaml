<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:compat="using:Shanquan.Inventory.Desktop.Compatibility"
        xmlns:vm="using:Shanquan.Inventory.Desktop.ViewModels.Dialogs"
        x:Class="Shanquan.Inventory.Desktop.Views.Dialogs.CustomerFormWindow"
        x:DataType="vm:CustomerFormViewModel"
        Width="560" Height="650" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="#F6F3F0"
        Title="客户档案">
    <Window.Styles>
        <Style Selector="TextBlock.label"><Setter Property="Foreground" Value="#5E5550" /><Setter Property="FontSize" Value="11" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="2,0,0,7" /></Style>
        <Style Selector="TextBox"><Setter Property="MinHeight" Value="44" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Background" Value="#FBF9F7" /><Setter Property="BorderBrush" Value="#DDD5CF" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="13,8" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
        <Style Selector="TextBox:pointerover"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#C7BAB3" /></Style>
        <Style Selector="TextBox:focus"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#9D3037" /><Setter Property="BorderThickness" Value="1.5" /></Style>
        <Style Selector="TextBox.center"><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="TextAlignment" Value="Center" /></Style>
        <Style Selector="Button"><Setter Property="MinHeight" Value="42" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="22,9" /><Setter Property="Cursor" Value="Hand" /></Style>
        <Style Selector="Button.secondary"><Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#4A403C" /><Setter Property="BorderBrush" Value="#D8CEC8" /><Setter Property="BorderThickness" Value="1" /></Style>
        <Style Selector="Button.primary"><Setter Property="Background" Value="#9D3037" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
    </Window.Styles>
    <compat:SpacingGrid RowDefinitions="Auto,*,Auto">
        <Border Background="White" BorderBrush="#E8E0DB" BorderThickness="0,0,0,1" Padding="30,24,30,21"><compat:SpacingGrid ColumnDefinitions="Auto,*" ColumnSpacing="14"><Border Width="42" Height="42" CornerRadius="11" Background="#F7E9E9"><TextBlock Text="客" Foreground="#9D3037" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="22" FontWeight="Bold" Foreground="#2F2926" /><TextBlock Text="建立完整客户资料，便于开单、发货与对账" Foreground="#817773" FontSize="11" Margin="0,5,0,0" /></StackPanel></compat:SpacingGrid></Border>
        <Border Grid.Row="1" Background="White" BorderBrush="#E8E0DB" BorderThickness="1" CornerRadius="14" Margin="24,20" Padding="22,20">
            <StackPanel Spacing="15">
                <compat:SpacingGrid ColumnDefinitions="1*,1.7*" ColumnSpacing="14"><StackPanel><TextBlock Text="客户编号" Classes="label" /><TextBox Classes="center" Text="{Binding Code}" Watermark="例如 KH001" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="客户名称" Classes="label" /><TextBox Text="{Binding Name}" Watermark="请输入客户或门店名称" /></StackPanel></compat:SpacingGrid>
                <StackPanel><TextBlock Text="联系电话" Classes="label" /><TextBox Classes="center" Text="{Binding Phone}" Watermark="手机号或固定电话" /></StackPanel>
                <StackPanel><TextBlock Text="客户地址" Classes="label" /><TextBox Text="{Binding Address}" Watermark="省市区、商场楼层及档口号" /></StackPanel>
                <compat:SpacingGrid ColumnDefinitions="1.4*,1*" ColumnSpacing="14"><StackPanel><TextBlock Text="信用额度（元）" Classes="label" /><TextBox Classes="center" Text="{Binding CreditLimitText}" Watermark="0.00" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="账期天数" Classes="label" /><TextBox Classes="center" Text="{Binding PaymentTermDaysText}" Watermark="30" /></StackPanel></compat:SpacingGrid>
                <Border IsVisible="{Binding HasError}" Background="#FFF3F2" CornerRadius="8" Padding="10,7"><TextBlock Text="{Binding ErrorMessage}" Foreground="#B42318" FontSize="11" HorizontalAlignment="Center" /></Border>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E8E0DB" BorderThickness="0,1,0,0" Padding="24,15"><compat:SpacingGrid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"><TextBlock Text="保存后会自动刷新客户列表" Foreground="#817773" FontSize="10" VerticalAlignment="Center" /><Button Grid.Column="1" Classes="secondary" Click="Cancel_Click">取消</Button><Button Grid.Column="2" Classes="primary" Click="Save_Click">保存客户</Button></compat:SpacingGrid></Border>
    </compat:SpacingGrid>
</Window>
