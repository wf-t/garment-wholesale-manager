<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:services="using:Shanquan.Inventory.Desktop.Services"
        x:Class="Shanquan.Inventory.Desktop.Views.Dialogs.SalesOrderPreviewWindow"
        x:DataType="services:SalesOrderPreviewData"
        Width="920" Height="680" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterOwner" Background="#F5F2EF"
        Title="销售单打印预览">
    <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="28">
        <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="盛轩服饰" FontSize="22" FontWeight="Bold" Foreground="#2D2522" /><TextBlock Text="销售单打印预览" Foreground="#8F2F35" FontWeight="SemiBold" Margin="0,5,0,0" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding DraftNumber}" Foreground="#817773" VerticalAlignment="Center" /></Grid>
        <Border Grid.Row="1" Background="White" BorderBrush="#E8E0DB" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,18,0,14"><Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" RowSpacing="8"><TextBlock Text="{Binding CustomerLabel}" /><TextBlock Grid.Column="1" Text="{Binding WarehouseLabel}" /><TextBlock Grid.Column="2" Text="{Binding DocumentDateLabel}" /><TextBlock Grid.Column="3" Text="{Binding PaymentStatusLabel}" /><TextBlock Grid.Row="1" Text="{Binding GoodsAmountLabel}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FreightLabel}" /><TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding DiscountLabel}" /><TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding PayableAmountLabel}" Foreground="#9D3037" FontWeight="Bold" /></Grid></Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E8E0DB" BorderThickness="1" CornerRadius="12" ClipToBounds="True"><Grid RowDefinitions="42,*"><Border Background="#F8F4F1" Padding="14,0"><Grid ColumnDefinitions="100,1.5*,90,70,70,90,100"><TextBlock Text="款号" VerticalAlignment="Center" /><TextBlock Grid.Column="1" Text="商品" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="颜色" VerticalAlignment="Center" /><TextBlock Grid.Column="3" Text="尺码" VerticalAlignment="Center" /><TextBlock Grid.Column="4" Text="数量" VerticalAlignment="Center" TextAlignment="Right" /><TextBlock Grid.Column="5" Text="单价" VerticalAlignment="Center" TextAlignment="Right" /><TextBlock Grid.Column="6" Text="金额" VerticalAlignment="Center" TextAlignment="Right" /></Grid></Border><ListBox Grid.Row="1" ItemsSource="{Binding Lines}" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate x:DataType="services:SalesOrderPreviewLine"><Border BorderBrush="#EEE8E4" BorderThickness="0,0,0,1" Padding="14,11"><Grid ColumnDefinitions="100,1.5*,90,70,70,90,100"><TextBlock Text="{Binding StyleNumber}" /><TextBlock Grid.Column="1" Text="{Binding ProductName}" /><TextBlock Grid.Column="2" Text="{Binding Color}" /><TextBlock Grid.Column="3" Text="{Binding Size}" /><TextBlock Grid.Column="4" Text="{Binding Quantity}" TextAlignment="Right" /><TextBlock Grid.Column="5" Text="{Binding UnitPrice}" TextAlignment="Right" /><TextBlock Grid.Column="6" Text="{Binding Amount}" TextAlignment="Right" FontWeight="SemiBold" /></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,16,0,0"><Button Content="关闭" Click="Close_Click" Padding="18,9" /><Button Content="导出打印文本" Click="Export_Click" Background="#8F2F35" Foreground="White" BorderThickness="0" CornerRadius="8" Padding="18,9" /></StackPanel>
    </Grid>
</Window>
