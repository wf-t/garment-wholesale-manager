<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Shanquan.Inventory.Desktop.ViewModels.Dialogs"
        xmlns:app="using:Shanquan.Inventory.Application.CoreBusiness"
        x:Class="Shanquan.Inventory.Desktop.Views.Dialogs.InventoryFormWindow"
        x:DataType="vm:InventoryFormViewModel"
        Width="980" Height="{Binding DialogHeight}" CanResize="False"
        WindowStartupLocation="CenterOwner" Background="#F8F7F6" Title="库存操作">
    <Window.Styles>
        <Style Selector="TextBlock.label"><Setter Property="Foreground" Value="#3E3734" /><Setter Property="FontSize" Value="12" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Margin" Value="1,0,0,7" /></Style>
        <Style Selector="TextBlock.hint"><Setter Property="Foreground" Value="#8A807B" /><Setter Property="FontSize" Value="10" /></Style>
        <Style Selector="TextBox"><Setter Property="MinHeight" Value="44" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#DDD8D4" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="13,8" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
        <Style Selector="TextBox:focus"><Setter Property="BorderBrush" Value="#D7192D" /><Setter Property="BorderThickness" Value="1.4" /></Style>
        <Style Selector="TextBox.center"><Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="TextAlignment" Value="Center" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style Selector="ComboBox"><Setter Property="MinHeight" Value="44" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#DDD8D4" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="12,5" /><Setter Property="VerticalContentAlignment" Value="Center" /></Style>
        <Style Selector="ComboBox:focus"><Setter Property="BorderBrush" Value="#D7192D" /></Style>
        <Style Selector="Button"><Setter Property="MinHeight" Value="40" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="18,8" /><Setter Property="Cursor" Value="Hand" /></Style>
        <Style Selector="Button.secondary"><Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#3E3734" /><Setter Property="BorderBrush" Value="#D8D2CE" /><Setter Property="BorderThickness" Value="1" /></Style>
        <Style Selector="Button.maintenance"><Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#D7192D" /><Setter Property="BorderBrush" Value="#D7192D" /><Setter Property="BorderThickness" Value="1" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style Selector="Button.dangerOutline"><Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#D7192D" /><Setter Property="BorderBrush" Value="#EF9BA3" /><Setter Property="BorderThickness" Value="1" /></Style>
        <Style Selector="Button.primary"><Setter Property="Background" Value="#D7192D" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style Selector="Button.icon"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#D7192D" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="5" /><Setter Property="MinWidth" Value="28" /><Setter Property="MinHeight" Value="28" /></Style>
        <Style Selector="Button.searchOption"><Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#332D2A" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="13,10" /></Style>
        <Style Selector="Button.searchOption:pointerover"><Setter Property="Background" Value="#FFF3F4" /></Style>
        <Style Selector="ItemsControl.productResults > ContentPresenter"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
        <Style Selector="Border.section"><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#E6E1DE" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="10" /><Setter Property="Padding" Value="20" /></Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <Border Background="White" BorderBrush="#E8E3E0" BorderThickness="0,0,0,1" Padding="28,18">
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16"><Border Width="48" Height="48" CornerRadius="10" Background="#FBE3E5"><TextBlock Text="库" Foreground="#D7192D" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontSize="23" FontWeight="Bold" Foreground="#25201E" /><TextBlock Text="{Binding Description}" Foreground="#746B67" FontSize="11" Margin="0,5,0,0" /></StackPanel></Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="26,18" Spacing="14">
                <StackPanel IsVisible="{Binding IsProduct}" Spacing="14">
                    <Border Classes="section"><StackPanel Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="10"><Border Width="22" Height="22" CornerRadius="11" Background="#D7192D"><TextBlock Text="1" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="基本信息" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" /></StackPanel>
                        <Grid ColumnDefinitions="1*,1*" ColumnSpacing="28"><StackPanel><TextBlock Text="款号  *" Classes="label" /><TextBox Text="{Binding StyleNumber}" PlaceholderText="例如 22717" MaxLength="50" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="商品名称  *" Classes="label" /><TextBox Text="{Binding ProductName}" PlaceholderText="请输入商品名称" MaxLength="100" /></StackPanel></Grid>
                        <Grid ColumnDefinitions="1*,1*" ColumnSpacing="28"><StackPanel><TextBlock Text="品类  *" Classes="label" /><Grid Width="430" HorizontalAlignment="Left" ColumnDefinitions="320,104" ColumnSpacing="6"><ComboBox Width="320" ItemsSource="{Binding Categories}" SelectedItem="{Binding SelectedCategory}" /><Button Grid.Column="1" Width="104" Classes="maintenance" Click="ManageCategories_Click" Padding="10,8">维护品类</Button></Grid></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="季节  *" Classes="label" /><ComboBox ItemsSource="{Binding Seasons}" SelectedItem="{Binding SelectedSeason}" /></StackPanel></Grid>
                    </StackPanel></Border>

                    <Border Classes="section"><StackPanel Spacing="15">
                        <StackPanel Orientation="Horizontal" Spacing="10"><Border Width="22" Height="22" CornerRadius="11" Background="#D7192D"><TextBlock Text="2" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Text="价格与仓库" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" /></StackPanel>
                        <Grid ColumnDefinitions="1*,1*,1.7*" ColumnSpacing="18"><StackPanel><TextBlock Text="统一零售价（元）  *" Classes="label" /><TextBox Classes="center" HorizontalAlignment="Stretch" Text="{Binding BasePriceText}" PlaceholderText="0.00" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="成本价（元）  *" Classes="label" /><TextBox Classes="center" HorizontalAlignment="Stretch" Text="{Binding CostPriceText}" PlaceholderText="0.00" /></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="入库仓库  *" Classes="label" /><Grid ColumnDefinitions="*,104" ColumnSpacing="6"><ComboBox HorizontalAlignment="Stretch" ItemsSource="{Binding WarehouseEntries}" SelectedItem="{Binding SelectedWarehouseEntry}" DisplayMemberBinding="{Binding DisplayName}" IsTextSearchEnabled="True" /><Button Grid.Column="1" Width="104" Classes="maintenance" Click="ManageWarehouses_Click" Padding="10,8">维护仓库</Button></Grid></StackPanel></Grid>
                    </StackPanel></Border>
                </StackPanel>

                <Border IsVisible="{Binding IsSku}" Classes="section"><StackPanel Spacing="15"><TextBlock Text="选择商品与仓库" FontSize="15" FontWeight="Bold" /><Grid ColumnDefinitions="1.3*,1*" ColumnSpacing="18"><StackPanel><TextBlock Text="商品款号（可输入搜索）" Classes="label" /><StackPanel x:Name="ProductSearchHost" Spacing="4"><Grid><TextBox x:Name="ProductSearchInput" Text="{Binding ProductSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="输入款号、品名、品类或季节" Padding="13,8,48,8" TextChanged="ProductSearchInput_TextChanged" GotFocus="ProductSearchInput_GotFocus" KeyDown="ProductSearchInput_KeyDown" /><Button Width="44" Height="44" HorizontalAlignment="Right" Background="Transparent" Foreground="#6F6560" BorderBrush="#DDD8D4" BorderThickness="1,0,0,0" CornerRadius="0,8,8,0" Padding="0" Click="ToggleProductDropDown_Click" ToolTip.Tip="展开商品列表"><Path Width="12" Height="8" Data="M 1,1 L 6,6 L 11,1" Stroke="#6F6560" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" /></Button></Grid><Border x:Name="ProductSearchPanel" IsVisible="False" Width="{Binding #ProductSearchInput.Bounds.Width}" HorizontalAlignment="Left" MaxHeight="320" Background="White" BorderBrush="#D8D2CE" BorderThickness="1" CornerRadius="9" BoxShadow="0 8 22 0 #26000000" ClipToBounds="True"><Grid RowDefinitions="Auto,*"><Border Background="#FAF8F7" BorderBrush="#ECE6E3" BorderThickness="0,0,0,1" Padding="13,9"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="选择商品" FontWeight="SemiBold" /><TextBlock x:Name="ProductResultCount" Grid.Column="1" Text="0 条结果" Foreground="#8A807B" FontSize="10" VerticalAlignment="Center" /></Grid></Border><ScrollViewer Grid.Row="1" MaxHeight="270" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel><ItemsControl Classes="productResults" HorizontalAlignment="Stretch" ItemsSource="{Binding FilteredProducts}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="app:ProductListItem"><Button Classes="searchOption" HorizontalAlignment="Stretch" Tag="{Binding}" Click="SelectProduct_Click"><Grid ColumnDefinitions="95,*,Auto" ColumnSpacing="12"><TextBlock Text="{Binding StyleNumber}" FontWeight="Bold" Foreground="#A32F38" VerticalAlignment="Center" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Category}" Foreground="#8A807B" FontSize="9" Margin="0,3,0,0" /></StackPanel><Border Grid.Column="2" Background="#F4F1EF" CornerRadius="10" Padding="9,3" VerticalAlignment="Center"><TextBlock Text="{Binding Season}" Foreground="#6F6560" FontSize="9" /></Border></Grid></Button></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Text="没有匹配商品，请先新增商品主档" IsVisible="{Binding HasNoFilteredProducts}" Foreground="#8A807B" HorizontalAlignment="Center" Margin="20" /></StackPanel></ScrollViewer></Grid></Border></StackPanel><TextBlock Text="支持款号、商品名称、品类和季节的任意关键词" Classes="hint" Margin="2,5,0,0" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="入库仓库" Classes="label" /><ComboBox ItemsSource="{Binding WarehouseEntries}" SelectedItem="{Binding SelectedWarehouseEntry}" DisplayMemberBinding="{Binding DisplayName}" IsEditable="True" IsTextSearchEnabled="True" /></StackPanel></Grid></StackPanel></Border>

                <Border IsVisible="{Binding ShowsVariantQuantity}" Classes="section"><StackPanel Spacing="12">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10"><Border Width="22" Height="22" CornerRadius="11" Background="#D7192D"><TextBlock Text="3" Foreground="White" FontWeight="Bold" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock Grid.Column="1" Text="商品规格（颜色尺码与数量）" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" /><TextBlock Grid.Column="2" Text="支持逐行录入颜色、尺码及每个规格的数量" Classes="hint" VerticalAlignment="Center" Margin="8,0,0,0" /><Button Grid.Column="3" Classes="secondary" Click="ManageColors_Click">🎨 颜色种类维护</Button></Grid>
                    <Border BorderBrush="#E4DFDC" BorderThickness="1" CornerRadius="8" ClipToBounds="True"><StackPanel><Grid ColumnDefinitions="34,1.7*,1.2*,1.1*,58" Background="#FAF8F7" Margin="8"><TextBlock Grid.Column="1" Text="颜色  *" Classes="hint" HorizontalAlignment="Center" /><TextBlock Grid.Column="2" Text="尺码  *" Classes="hint" HorizontalAlignment="Center" /><TextBlock Grid.Column="3" Text="数量  *" Classes="hint" HorizontalAlignment="Center" /><TextBlock Grid.Column="4" Text="操作" Classes="hint" HorizontalAlignment="Center" /></Grid><ItemsControl ItemsSource="{Binding VariantEntries}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ProductVariantEntry"><Border BorderBrush="#ECE7E4" BorderThickness="0,1,0,0" Padding="8"><Grid ColumnDefinitions="34,1.7*,1.2*,1.1*,58" ColumnSpacing="10"><TextBlock Text="⠿" Foreground="#8A807B" HorizontalAlignment="Center" VerticalAlignment="Center" /><ComboBox Grid.Column="1" ItemsSource="{Binding ColorOptions}" SelectedItem="{Binding SelectedColor}" Text="{Binding ColorCode}" IsEditable="True" IsTextSearchEnabled="True" PlaceholderText="选择或输入颜色"><ComboBox.ItemTemplate><DataTemplate x:DataType="vm:ColorChoice"><TextBlock Text="{Binding DisplayName}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><ComboBox Grid.Column="2" ItemsSource="{Binding SizeOptions}" Text="{Binding SizeCode}" IsEditable="True" IsTextSearchEnabled="True" PlaceholderText="选择或输入尺码" /><Border Grid.Column="3" BorderBrush="#DDD8D4" BorderThickness="1" CornerRadius="8" Background="White"><Grid ColumnDefinitions="30,*,30"><Button Classes="icon" Foreground="#3E3734" Content="−" Tag="{Binding}" Click="DecrementVariant_Click" /><TextBox Grid.Column="1" Classes="center" Text="{Binding QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Padding="2" MinHeight="38" /><Button Grid.Column="2" Classes="icon" Foreground="#3E3734" Content="＋" Tag="{Binding}" Click="IncrementVariant_Click" /></Grid></Border><Button Grid.Column="4" Classes="icon" Content="🗑" Tag="{Binding}" Click="RemoveVariant_Click" ToolTip.Tip="删除规格" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
                    <Button Classes="dangerOutline" HorizontalAlignment="Left" Command="{Binding AddVariantCommand}">＋ 添加规格</Button>
                    <Border Background="#EDF6FF" BorderBrush="#BBDCFB" BorderThickness="1" CornerRadius="7" Padding="11,8"><TextBlock Text="{Binding VariantCountText}" Foreground="#2774C5" FontSize="10" /></Border>
                </StackPanel></Border>

                <Border IsVisible="{Binding IsEditSku}" Classes="section"><StackPanel Spacing="14"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="商品规格（颜色和尺码均可搜索或自定义）" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" /><Button Grid.Column="1" Classes="secondary" Click="ManageColors_Click">🎨 颜色种类维护</Button></Grid><ItemsControl ItemsSource="{Binding VariantEntries}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ProductVariantEntry"><Grid ColumnDefinitions="1.4*,1*" ColumnSpacing="16"><StackPanel><TextBlock Text="颜色" Classes="label" /><ComboBox ItemsSource="{Binding ColorOptions}" SelectedItem="{Binding SelectedColor}" Text="{Binding ColorCode}" IsEditable="True" IsTextSearchEnabled="True" PlaceholderText="选择或输入颜色" /></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="尺码" Classes="label" /><ComboBox ItemsSource="{Binding SizeOptions}" Text="{Binding SizeCode}" IsEditable="True" IsTextSearchEnabled="True" PlaceholderText="选择或输入尺码" /></StackPanel></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><StackPanel><TextBlock Text="条码（可选）" Classes="label" /><TextBox Text="{Binding Barcode}" PlaceholderText="扫描或输入商品条码" /></StackPanel></StackPanel></Border>

                <Border IsVisible="{Binding IsStock}" Classes="section">
                    <StackPanel Spacing="15">
                        <TextBlock Text="选择仓库与款号" FontSize="15" FontWeight="Bold" />
                        <Grid ColumnDefinitions="0.85*,1.55*" ColumnSpacing="18">
                            <StackPanel>
                                <TextBlock Text="仓库  *" Classes="label" />
                                <ComboBox ItemsSource="{Binding WarehouseEntries}" SelectedItem="{Binding SelectedWarehouseEntry}" DisplayMemberBinding="{Binding DisplayName}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="商品款号（可输入搜索）" Classes="label" />
                                <StackPanel Spacing="4">
                                    <Grid>
                                        <TextBox x:Name="StockProductSearchInput" Text="{Binding ProductSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="输入款号、品名、品类或季节" Padding="13,8,48,8" TextChanged="StockProductSearchInput_TextChanged" GotFocus="StockProductSearchInput_GotFocus" KeyDown="StockProductSearchInput_KeyDown" />
                                        <Button Width="44" Height="44" HorizontalAlignment="Right" Background="Transparent" Foreground="#6F6560" BorderBrush="#DDD8D4" BorderThickness="1,0,0,0" CornerRadius="0,8,8,0" Padding="0" Click="ToggleStockProductDropDown_Click" ToolTip.Tip="展开商品列表">
                                            <Path Width="12" Height="8" Data="M 1,1 L 6,6 L 11,1" Stroke="#6F6560" StrokeThickness="1.6" StrokeLineCap="Round" StrokeJoin="Round" />
                                        </Button>
                                    </Grid>
                                    <Border x:Name="StockProductSearchPanel" IsVisible="False" Width="{Binding #StockProductSearchInput.Bounds.Width}" HorizontalAlignment="Left" MaxHeight="320" Background="White" BorderBrush="#D8D2CE" BorderThickness="1" CornerRadius="9" BoxShadow="0 8 22 0 #26000000" ClipToBounds="True" ZIndex="20">
                                        <Grid RowDefinitions="Auto,*">
                                            <Border Background="#FAF8F7" BorderBrush="#ECE6E3" BorderThickness="0,0,0,1" Padding="13,9">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="选择商品" FontWeight="SemiBold" />
                                                    <TextBlock x:Name="StockProductResultCount" Grid.Column="1" Text="0 条结果" Foreground="#8A807B" FontSize="10" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                            <ScrollViewer Grid.Row="1" MaxHeight="270" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                                <StackPanel>
                                                    <ItemsControl Classes="productResults" HorizontalAlignment="Stretch" ItemsSource="{Binding FilteredProducts}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="app:ProductListItem">
                                                                <Button Classes="searchOption" HorizontalAlignment="Stretch" Tag="{Binding}" Click="SelectStockProduct_Click">
                                                                    <Grid ColumnDefinitions="95,*,Auto" ColumnSpacing="12">
                                                                        <TextBlock Text="{Binding StyleNumber}" FontWeight="Bold" Foreground="#A32F38" VerticalAlignment="Center" />
                                                                        <StackPanel Grid.Column="1">
                                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                                            <TextBlock Text="{Binding Category}" Foreground="#8A807B" FontSize="9" Margin="0,3,0,0" />
                                                                        </StackPanel>
                                                                        <Border Grid.Column="2" Background="#F4F1EF" CornerRadius="10" Padding="9,3" VerticalAlignment="Center">
                                                                            <TextBlock Text="{Binding Season}" Foreground="#6F6560" FontSize="9" />
                                                                        </Border>
                                                                    </Grid>
                                                                </Button>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Text="没有匹配商品，请先新增商品主档" IsVisible="{Binding HasNoFilteredProducts}" Foreground="#8A807B" HorizontalAlignment="Center" Margin="20" />
                                                </StackPanel>
                                            </ScrollViewer>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="只搜索款号，选定后再维护本款颜色和尺码" Classes="hint" Margin="2,5,0,0" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="Auto,*">
                                <TextBlock Text="本款颜色尺码" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding StockHintText}" Classes="hint" VerticalAlignment="Center" Margin="12,0,0,0" />
                            </Grid>
                            <Border IsVisible="{Binding HasStockRows}" BorderBrush="#E4DFDC" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                <StackPanel>
                                    <Grid ColumnDefinitions="1*,0.7*,0.55*,0.55*,0.55*,1.35*,0.55*" Background="#FAF8F7" Margin="8,8,8,4">
                                        <TextBlock Text="颜色" Classes="hint" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="尺码" Classes="hint" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="实际" Classes="hint" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="3" Text="锁定" Classes="hint" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="4" Text="可用" Classes="hint" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="5" Text="{Binding StockInputLabel}" Classes="hint" HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="6" Text="差额" Classes="hint" HorizontalAlignment="Center" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding StockRows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:StockSkuLine">
                                                <Border BorderBrush="#ECE7E4" BorderThickness="0,1,0,0" Padding="8">
                                                    <Grid ColumnDefinitions="1*,0.7*,0.55*,0.55*,0.55*,1.35*,0.55*" ColumnSpacing="6">
                                                        <TextBlock Text="{Binding ColorCode}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="1" Text="{Binding SizeCode}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="2" Text="{Binding OnHand}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="3" Text="{Binding Reserved}" Foreground="#6F6661" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <TextBlock Grid.Column="4" Text="{Binding Available}" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        <Border Grid.Column="5" BorderBrush="#DDD8D4" BorderThickness="1" CornerRadius="8" Background="White">
                                                            <Grid ColumnDefinitions="30,*,30">
                                                                <Button Classes="icon" Foreground="#3E3734" Content="−" Tag="{Binding}" Click="DecrementStock_Click" />
                                                                <TextBox Grid.Column="1" Classes="center" Text="{Binding QuantityText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0" Background="Transparent" Padding="2" MinHeight="38" />
                                                                <Button Grid.Column="2" Classes="icon" Foreground="#3E3734" Content="＋" Tag="{Binding}" Click="IncrementStock_Click" />
                                                            </Grid>
                                                        </Border>
                                                        <TextBlock Grid.Column="6" Text="{Binding ChangeText}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#A32F38" FontWeight="SemiBold" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                            <Border IsVisible="{Binding HasNoStockRows}" Background="#FAF8F7" BorderBrush="#E6E1DE" BorderThickness="1" CornerRadius="8" Padding="18">
                                <TextBlock Text="{Binding StockEmptyText}" Foreground="#8A807B" HorizontalAlignment="Center" />
                            </Border>
                        </StackPanel>

                        <StackPanel>
                            <TextBlock Text="{Binding StockNoteLabel}" Classes="label" />
                            <TextBox Text="{Binding Note}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border IsVisible="{Binding HasError}" Background="#FFF0F1" BorderBrush="#F5B9BF" BorderThickness="1" CornerRadius="8" Padding="11"><TextBlock Text="{Binding ErrorMessage}" Foreground="#B4232D" HorizontalAlignment="Center" /></Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="White" BorderBrush="#E8E3E0" BorderThickness="0,1,0,0" Padding="24,13"><Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"><TextBlock Text="ⓘ  商品和库存变动均保存到本地数据库" Foreground="#817773" FontSize="10" VerticalAlignment="Center" /><Button Grid.Column="1" Classes="secondary" Click="Cancel_Click">取消</Button><Button Grid.Column="2" Classes="primary" Click="Save_Click"><TextBlock Text="{Binding SaveText}" /></Button></Grid></Border>
    </Grid>
</Window>
