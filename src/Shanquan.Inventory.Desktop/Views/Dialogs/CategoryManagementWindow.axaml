<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:compat="using:Shanquan.Inventory.Desktop.Compatibility"
        xmlns:vm="using:Shanquan.Inventory.Desktop.ViewModels.Dialogs"
        x:Class="Shanquan.Inventory.Desktop.Views.Dialogs.CategoryManagementWindow"
        x:DataType="vm:CategoryManagementViewModel"
        Width="700" Height="650" MinWidth="620" MinHeight="540" CanResize="True"
        WindowStartupLocation="CenterOwner" Background="#F8F7F6" Title="品类维护">
    <Window.Styles>
        <Style Selector="Button"><Setter Property="Cursor" Value="Hand" /><Setter Property="MinHeight" Value="38" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Padding" Value="15,7" /></Style>
        <Style Selector="Button.primary"><Setter Property="Background" Value="#D7192D" /><Setter Property="Foreground" Value="White" /><Setter Property="BorderThickness" Value="0" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
        <Style Selector="Button.secondary"><Setter Property="Background" Value="White" /><Setter Property="Foreground" Value="#3E3734" /><Setter Property="BorderBrush" Value="#DDD6D2" /><Setter Property="BorderThickness" Value="1" /></Style>
        <Style Selector="Button.danger"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#D7192D" /><Setter Property="BorderThickness" Value="0" /></Style>
        <Style Selector="Button.text"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="#625956" /><Setter Property="BorderThickness" Value="0" /></Style>
        <Style Selector="TextBox"><Setter Property="MinHeight" Value="42" /><Setter Property="CornerRadius" Value="8" /><Setter Property="Background" Value="White" /><Setter Property="BorderBrush" Value="#DDD6D2" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Padding" Value="11,7" /></Style>
        <Style Selector="TextBox:focus"><Setter Property="BorderBrush" Value="#D7192D" /></Style>
    </Window.Styles>

    <compat:SpacingGrid RowDefinitions="Auto,*,Auto">
        <Border Background="White" BorderBrush="#E8E3E0" BorderThickness="0,0,0,1" Padding="24,18">
            <StackPanel><TextBlock Text="品类维护" FontSize="22" FontWeight="Bold" /><TextBlock Text="集中管理商品品类；重命名后会同步更新关联商品。" Foreground="#817773" FontSize="11" Margin="0,5,0,0" /></StackPanel>
        </Border>

        <compat:SpacingGrid Grid.Row="1" RowDefinitions="Auto,Auto,*" Margin="22,18" RowSpacing="14">
            <Border Background="White" BorderBrush="#E6E1DE" BorderThickness="1" CornerRadius="10" Padding="16">
                <StackPanel Spacing="10"><TextBlock Text="新增品类" FontSize="15" FontWeight="SemiBold" /><compat:SpacingGrid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding NewCategoryName, Mode=TwoWay}" Watermark="输入新品类名称" MaxLength="80" /><Button Grid.Column="1" Classes="primary" Command="{Binding AddCategoryCommand}">＋ 新增</Button></compat:SpacingGrid></StackPanel>
            </Border>

            <compat:SpacingGrid Grid.Row="1" ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <compat:SpacingGrid><TextBox Text="{Binding SearchText, Mode=TwoWay}" Watermark="搜索品类名称" Padding="38,7,11,7" /><TextBlock Text="⌕" FontSize="18" Foreground="#817773" Margin="13,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" /></compat:SpacingGrid>
                <TextBlock Grid.Column="1" Text="{Binding ResultSummary}" Foreground="#817773" FontSize="11" VerticalAlignment="Center" />
            </compat:SpacingGrid>

            <Border Grid.Row="2" Background="White" BorderBrush="#E6E1DE" BorderThickness="1" CornerRadius="10" ClipToBounds="True">
                <compat:SpacingGrid RowDefinitions="Auto,*">
                    <Border Background="#FAF8F7" BorderBrush="#ECE7E4" BorderThickness="0,0,0,1" Padding="16,10"><compat:SpacingGrid ColumnDefinitions="*,210"><TextBlock Text="品类名称" Foreground="#817773" FontSize="10" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="操作" Foreground="#817773" FontSize="10" FontWeight="SemiBold" HorizontalAlignment="Center" /></compat:SpacingGrid></Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <compat:SpacingGrid>
                            <ItemsControl ItemsSource="{Binding FilteredCategories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:CategoryManagementItem">
                                        <Border BorderBrush="#EEE9E6" BorderThickness="0,0,0,1" Padding="14,9">
                                            <compat:SpacingGrid>
                                                <compat:SpacingGrid IsVisible="{Binding IsNotEditing}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" />
                                                    <Button Grid.Column="1" Classes="secondary" Content="编辑" Tag="{Binding}" Click="EditCategory_Click" />
                                                    <Button Grid.Column="2" Classes="danger" Content="删除" Tag="{Binding}" Click="DeleteCategory_Click" />
                                                </compat:SpacingGrid>
                                                <compat:SpacingGrid IsVisible="{Binding IsEditing}" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                                                    <TextBox Text="{Binding EditName, Mode=TwoWay}" MaxLength="80" />
                                                    <Button Grid.Column="1" Classes="primary" Content="保存" Tag="{Binding}" Click="SaveCategory_Click" />
                                                    <Button Grid.Column="2" Classes="text" Content="取消" Tag="{Binding}" Click="CancelEdit_Click" />
                                                </compat:SpacingGrid>
                                            </compat:SpacingGrid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <StackPanel IsVisible="{Binding HasNoResults}" VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="8" Margin="24"><TextBlock Text="暂无匹配品类" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" /><TextBlock Text="请更换搜索关键词或新增品类" Foreground="#817773" FontSize="10" /></StackPanel>
                        </compat:SpacingGrid>
                    </ScrollViewer>
                </compat:SpacingGrid>
            </Border>
        </compat:SpacingGrid>

        <Border Grid.Row="2" Background="White" BorderBrush="#E8E3E0" BorderThickness="0,1,0,0" Padding="20,12">
            <compat:SpacingGrid ColumnDefinitions="*,Auto" ColumnSpacing="12"><Border Background="#EDF6FF" BorderBrush="#BBDCFB" BorderThickness="1" CornerRadius="8" Padding="11,8"><TextBlock Text="{Binding StatusMessage}" Foreground="#2774C5" FontSize="10" TextWrapping="Wrap" /></Border><Button Grid.Column="1" Classes="secondary" Click="Close_Click">完成</Button></compat:SpacingGrid>
        </Border>
    </compat:SpacingGrid>
</Window>
